# Copy to .env. Mayajaal auto-loads backend/.env via python-dotenv at startup,
# so no shell sourcing or `export` is required:
#   cp .env.example .env
# Never commit the resulting .env file.
OPENAI_API_KEY=""

# Local PostgreSQL development service. These are intentionally local-only
# credentials, not production secrets. Use stronger values outside this setup.
MAYAJAAL_POSTGRES_DB="mayajaal"
MAYAJAAL_POSTGRES_USER="mayajaal"
MAYAJAAL_POSTGRES_PASSWORD="mayajaal-local-only"
MAYAJAAL_DATABASE_URL="postgresql+psycopg://mayajaal:mayajaal-local-only@localhost:5433/mayajaal"

# Local-only webhook signing secret used by `just webhook-simulate`. Razorpay
# never sees this value; production deployments must set a distinct secret.
MAYAJAAL_RAZORPAY_WEBHOOK_SECRET="mayajaal-local-webhook-secret"
