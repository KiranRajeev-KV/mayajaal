# Copy to .env and source it in the shell that starts a live investigation:
#   cp .env.example .env
#   source .env
# Never commit the resulting .env file.
OPENAI_API_KEY=""

# Local PostgreSQL development service. These are intentionally local-only
# credentials, not production secrets. Use stronger values outside this setup.
export MAYAJAAL_POSTGRES_DB="mayajaal"
export MAYAJAAL_POSTGRES_USER="mayajaal"
export MAYAJAAL_POSTGRES_PASSWORD="mayajaal-local-only"
export MAYAJAAL_DATABASE_URL="postgresql+psycopg://mayajaal:mayajaal-local-only@localhost:5433/mayajaal"
