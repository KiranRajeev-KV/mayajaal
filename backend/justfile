# Backend quality and test commands. Run `just --list` to discover recipes.
set quiet
default: check

# Apply Ruff's formatter and safe lint fixes.
fix:
    uv run ruff format .
    uv run ruff check --fix .

# Apply Ruff's formatter.
format:
    uv run ruff format .

# Verify that formatting is already canonical.
format-check:
    uv run ruff format --check .

# Run Ruff's linter.
lint:
    uv run ruff check .

# Run strict static type checking.
typecheck:
    uv run basedpyright --project pyproject.toml

# Verify dependency declarations against imports.
deps:
    uv run deptry .

# Report only Vulture findings with 100% confidence.
dead-code:
    uv run vulture main.py mayajaal tests --min-confidence 100

# Run the schema unit-test suite.
test:
    @uv run python -m unittest discover -s tests -q

# Generate Parquet tables from config.toml, or pass another config path.
generate config="config.toml":
    uv run python -m scripts.generate_dataset --config {{ config }}

# Generate, resolve, and load the derived graph into local Neo4j.
neo4j-load config="config.toml":
    uv run python -m scripts.load_neo4j --config {{ config }}

# Delete the dedicated derived graph before loading a different dataset.
neo4j-reset:
    uv run python -m scripts.reset_neo4j

# PostgreSQL operational-storage foundation. Mayajaal auto-loads backend/.env
# via python-dotenv, so copy .env.example to .env and run these directly.
db-migrate:
    uv run alembic upgrade head

db-current:
    uv run alembic current

db-ping:
    uv run python -m scripts.db_ping

# Run the thin operational read API. It requires MAYAJAAL_DATABASE_URL from
# backend/.env, which is auto-loaded at startup.
api-run:
    uv run uvicorn mayajaal.api.app:create_app --factory --reload

# Deliver deterministic Razorpay-shaped local webhook fixtures to api-run.
# backend/.env is auto-loaded so the simulator and endpoint share the local secret.
webhook-simulate mode="normal" endpoint="http://127.0.0.1:8000":
    uv run python -m scripts.simulate_webhook --mode {{mode}} --endpoint {{endpoint}}

# Normalize and incrementally project one durable event, or a bounded ready batch.
webhook-process event_id="" limit="":
    if [ -n "{{event_id}}" ]; then uv run python -m scripts.process_webhooks --event-id {{event_id}}; else uv run python -m scripts.process_webhooks --limit {{limit}}; fi

risk-process event_id:
    uv run python -m scripts.process_risk --event-id {{event_id}}

# Recover bounded durable Stage 12B/12C work after an API background failure.
realtime-process event_id="" limit="":
    if [ -n "{{event_id}}" ]; then uv run python -m scripts.process_realtime --event-id {{event_id}}; else uv run python -m scripts.process_realtime --limit {{limit}}; fi

# Explicitly recover one user-triggered Terra investigation job.
investigation-process run_id:
    uv run python -m scripts.process_investigation --run-id {{run_id}}

# Opt-in real PostgreSQL race contracts; requires local db-migrate first.
postgres-risk-concurrency-test:
    MAYAJAAL_RUN_POSTGRES_TESTS=1 uv run python -m unittest tests.test_postgres_risk_concurrency -q

# Opt-in PostgreSQL idempotent investigation-trigger race contract.
postgres-investigation-concurrency-test:
    MAYAJAAL_RUN_POSTGRES_TESTS=1 uv run python -m unittest tests.test_postgres_investigation_concurrency -q

# Export cutoff-safe account graph features as Parquet.
features-extract config="config.toml":
    uv run python -m scripts.extract_features --config {{ config }}

# Train and persist the deterministic CatBoost baseline plus SHAP summary.
baseline-train config="config.toml":
    uv run python -m scripts.train_baseline --config {{ config }}

# Run chronological train/validation/held-out CatBoost evaluation. For the
# configured 10k benchmark: `just held-out-evaluate --full`.
held-out-evaluate *args:
    uv run python -m scripts.evaluate_held_out --config config.toml {{ args }}

# Fit sigmoid calibration on chronological validation scores and evaluate it once
# on held-out test scores. For the configured 10k benchmark add `--full`.
calibration-evaluate *args:
    uv run python -m scripts.evaluate_calibration --config config.toml {{ args }}

# Make one cost-sensitive ALLOW / REVIEW / BLOCK decision from a verified
# frozen evaluation sample (pass --sample-id from split_manifest.json).
policy-decide *args:
    uv run python -m scripts.decide_policy --config config.toml {{ args }}

# Run the frozen six-case/three-model investigation comparison sequentially.
# This intentionally performs 18 live investigation runs (successful runs make
# ~2 model calls each).
investigation-model-comparison *args:
    uv run python -m scripts.run_investigation_model_comparison --config config.toml {{ args }}

# Run multi-seed realism diagnostics; pass flags after the recipe name.
synthetic-validate *args:
    uv run python -m scripts.validate_synthetic --config config.toml {{ args }}

# Run diagnostics against a non-default profile, followed by optional flags.
synthetic-validate-config config *args:
    uv run python -m scripts.validate_synthetic --config {{ config }} {{ args }}

# Run every non-mutating quality gate.
check: format-check lint typecheck deps dead-code test
